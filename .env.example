# 复制成 .env 再修改：cp .env.example .env

# 用 Claude 做 AI 审核时可以填在这里，也可以在管理后台里填
# ANTHROPIC_API_KEY=

# 本机端口（反向代理转发到这里）
# APP_PORT=3000

# App 更新提示：安装包从哪个仓库的 Releases 找、用哪些加速镜像下载（none = 只用 GitHub 直连）
# App 下载后会核对 SHA-256 和官方签名，镜像改不了安装包
# APP_RELEASE_REPO=QingYun4ever/CampusX
# APP_DOWNLOAD_MIRRORS=https://v4.gh-proxy.org/,https://axisnow.gh-proxy.org/,https://v6.gh-proxy.org/,https://gh-proxy.org/

# 站点图片累计上传配额（不含私信）和未引用文件的保留时间
# UPLOAD_ACCOUNT_LIMIT_BYTES=268435456
# UPLOAD_SITE_LIMIT_BYTES=10737418240
# UPLOAD_ORPHAN_TTL_MS=86400000

# 可选：图片和视频放到 S3 兼容的对象存储（比如雨云 RainS3），大流量不走服务器带宽。
# 五项都填了才启用；MEDIA_REMOTE=off 临时改回服务器直出。密钥只写在 .env 里，不要提交。
# S3_ENDPOINT=https://cn-nb2.rains3.com
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# MEDIA_PUBLIC_BASE=https://cos.example.com
# S3_REGION=us-east-1
# S3_PREFIX=
# 存储桶总量上限、每月下载流量上限（GB）、往存储桶传文件的限速（KB/s）
# MEDIA_REMOTE_MAX_GB=18
# MEDIA_REMOTE_MONTHLY_GB=90
# MEDIA_UPLOAD_KBPS=1024

# 原生 App 之外还有别的网页要跨域调用 API 时才需要改
# CORS_ORIGINS=capacitor://localhost,https://localhost

# 可选：邮箱绑定。未配置时仍可注册、登录和使用两步验证
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=0
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=forum@example.com
