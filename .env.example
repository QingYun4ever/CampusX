# 复制成 .env 再修改：cp .env.example .env

# 用 Claude 做 AI 审核时可以填在这里，也可以在管理后台里填
# ANTHROPIC_API_KEY=

# 本机端口（反向代理转发到这里）
# APP_PORT=3000

# App 更新提示：安装包从哪个仓库的 Releases 找、用哪些加速镜像下载（none = 只用 GitHub 直连）
# APP_RELEASE_REPO=QingYun4ever/CampusX
# APP_DOWNLOAD_MIRRORS=https://ghfast.top/,https://gh-proxy.com/,https://ghproxy.net/

# 原生 App 之外还有别的网页要跨域调用 API 时才需要改
# CORS_ORIGINS=capacitor://localhost,https://localhost

# 可选：邮箱绑定。未配置时仍可注册、登录和使用两步验证
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=0
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=forum@example.com
